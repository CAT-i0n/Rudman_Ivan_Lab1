city_aliases = {
        'Москва': [' москва', 'МОСКВА', 'г. Москва', 'Москва'],
        'Санкт-Петербург': ['г. Санкт-Петербург', 'СПб', 'Санкт-Петербург', 'Санкт Петербург'],
        'Екатеринбург': ['г.Екатеринбург', 'Екатеринбург', 'ЕКАТЕРИНБУРГ'],
        'Казань': ['Казань', 'казань'],
        'Нижний Новгород': ['Нижний Новгород', 'Н. Новгород'],
        'Новосибирск': ['г. Новосибирск', 'Новосибирск'],
    }
reverse_city_aliases = {alias: city for city, aliases in city_aliases.items() for alias in aliases}

def city_name(city_name):
    return reverse_city_aliases.get(city_name, city_name)

df_clients['city'] = df_clients['city'].apply(city_name)


df_clients['city'].value_counts().plot(kind='bar', figsize=(5, 3), title='City Distribution', rot=45)





